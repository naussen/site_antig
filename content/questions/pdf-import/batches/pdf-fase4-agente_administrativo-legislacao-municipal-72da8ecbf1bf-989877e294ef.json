    {
      "external_id": "pdf:agente_administrativo:032",
      "source_id": "agente_administrativo:32",
      "question_type": "true_false",
      "statement_markdown": "Com relação à Lei Orgânica do Município de Cachoeiro de Itapemirim, julgue os itens que se seguem.\n\nO município poderá sofrer intervenção estadual se deixar de prestar as contas devidas, na forma da lei, e(ou) se não aplicar o mínimo exigido da receita municipal na manutenção e no desenvolvimento do ensino.",
      "exam_board": "CEBRASPE",
      "institution": "Prefeitura de Cachoeiro de Itapemirim",
      "position_name": "Agente Administrativo",
      "exam_year": 2024,
