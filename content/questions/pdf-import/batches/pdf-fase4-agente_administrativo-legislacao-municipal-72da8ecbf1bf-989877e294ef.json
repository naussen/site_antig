    {
      "external_id": "pdf:agente_administrativo:038",
      "source_id": "agente_administrativo:38",
      "question_type": "true_false",
      "statement_markdown": "A respeito do Estatuto dos Servidores Públicos do Município de Cachoeiro de Itapemirim (Lei Municipal n.º 4.009/1994), julgue os itens a seguir.\n\nAo entrar em exercício, o servidor nomeado para cargo de provimento efetivo ficará sujeito a estágio probatório por período de trinta e seis meses, durante o qual sua aptidão e sua capacidade serão objeto de avaliação para o desempenho do cargo.",
      "exam_board": "CEBRASPE",
      "institution": "Prefeitura de Cachoeiro de Itapemirim",
      "position_name": "Agente Administrativo",
      "exam_year": 2024,
      "difficulty": "medium",
