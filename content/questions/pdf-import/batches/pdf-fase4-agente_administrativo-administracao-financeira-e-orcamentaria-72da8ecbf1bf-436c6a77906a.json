    {
      "external_id": "pdf:agente_administrativo:071",
      "source_id": "agente_administrativo:71",
      "question_type": "true_false",
      "statement_markdown": "Acerca de orçamento público, julgue os itens que se seguem.\n\nAs despesas públicas municipais referem-se aos gastos realizados pelos municípios no cumprimento de suas atribuições e na provisão de bens e serviços públicos.",
      "exam_board": "CEBRASPE",
      "institution": "Prefeitura de Cachoeiro de Itapemirim",
