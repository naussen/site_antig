          "sort_order": 0,
          "is_correct": false
        },
        {
          "label": "E",
          "body_markdown": "Errado",
          "sort_order": 1,
          "is_correct": true
        }
      ],
      "correct_option_label": "E",
      "subject": "Controle da Administração Pública e Tribunais de Contas",
      "source_metadata": {
        "source_file": "prova_conhec_espec_tec_federal_control_exter_tec_adm.json",
