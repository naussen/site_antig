          "sort_order": 0,
          "is_correct": false
        },
        {
          "label": "E",
          "body_markdown": "Errado",
          "sort_order": 1,
          "is_correct": true
        }
      ],
      "correct_option_label": "E",
      "subject": "Ética, Moral, Cidadania e Democracia",
      "source_metadata": {
        "source_file": "agente_administrativo.json",
        "source_schema_version": "pro-questions/extracted-pdf/v1",
        "source_subject": "Ética e Cidadania",
        "source_content_hash": "6d86edea79d0f79cea68248a67b41006f26f08576bae834a62ba09b3940a5f04",
        "original_numeric_id": 45,
        "original_source_content_hash": null,
        "answer_status": "definitivo",
        "commentary_review_status": "revisada_por_modelo",
        "outdated_notice": null,
