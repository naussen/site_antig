        "source_content_hash": "9f7570df89a5d4334ab56c002cc18778574efa4c92e5a1dfd81578b93e9845fd",
        "original_numeric_id": 47,
        "original_source_content_hash": null,
        "answer_status": "definitivo",
        "commentary_review_status": "revisada_por_modelo",
