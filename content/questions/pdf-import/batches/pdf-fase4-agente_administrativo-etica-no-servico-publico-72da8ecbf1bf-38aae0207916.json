          "sort_order": 1,
          "is_correct": false
        }
      ],
      "correct_option_label": "C",
      "subject": "Ética, Moral, Cidadania e Democracia",
      "source_metadata": {
        "source_file": "agente_administrativo.json",
        "source_schema_version": "pro-questions/extracted-pdf/v1",
        "source_subject": "Ética e Cidadania",
        "source_content_hash": "de0c10e45318e5464ac8bde62676b0a522eb15f585a70758bf4a9e096262167c",
        "original_numeric_id": 44,
        "original_source_content_hash": null,
        "answer_status": "definitivo",
        "commentary_review_status": "revisada_por_modelo",
        "outdated_notice": null,
        "calculation_image_url": null,
        "classification": "saneamento consolidado Fase 4",
        "official_url": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm"
      },
      "topics": [
        {
          "topic_id": "etica-aspectos-teoricos",
          "relation_type": "primary",
          "relevance": 100,
          "sort_order": 0
        }
      ],
      "explanation": {
        "body_markdown": "**Gabarito: Certo.**\n\nA cidadania pressupõe o respeito recíproco às normas legais e aos direitos fundamentais de todos os integrantes do pacto social. Ao sonegar o registro em carteira e os encargos trabalhistas e previdenciários de empregada doméstica, o empregador vulnera o sistema de seguridade e a legalidade trabalhista, enfraquecendo a ordem jurídica e econômica da qual ele próprio usufrui enquanto cidadão.",
        "source_reference": null
      },
      "source_content_hash": "c845bca1c8ae32d56d92a600e4d08cff515486f3d427878ede849ceb021a6ae8"
    },
    {
      "external_id": "pdf:agente_administrativo:045",
      "source_id": "agente_administrativo:45",
      "question_type": "true_false",
      "statement_markdown": "Julgue os itens subsecutivos, a respeito da ética, da democracia e do exercício de cidadania.\n\nO recolhimento de tributos constitui exemplo de cidadania empresarial, não se podendo dizer o mesmo de projeto de inclusão social implantado por uma organização para atender as famílias carentes em seu entorno.",
      "exam_board": "CEBRASPE",
      "institution": "Prefeitura de Cachoeiro de Itapemirim",
      "position_name": "Agente Administrativo",
      "exam_year": 2024,
      "difficulty": "medium",
      "source_reference": "agente_administrativo.pdf, questão 45; agente_administrativo_gabarito.pdf",
      "options": [
        {
          "label": "C",
