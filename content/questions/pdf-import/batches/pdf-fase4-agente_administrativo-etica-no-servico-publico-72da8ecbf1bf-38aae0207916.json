    {
      "external_id": "pdf:agente_administrativo:044",
      "source_id": "agente_administrativo:44",
      "question_type": "true_false",
      "statement_markdown": "Julgue os itens subsecutivos, a respeito da ética, da democracia e do exercício de cidadania.\n\nO empregador que não assina a carteira de sua empregada doméstica está prejudicando uma ordem social da qual ele mesmo se beneficia.",
      "exam_board": "CEBRASPE",
      "institution": "Prefeitura de Cachoeiro de Itapemirim",
      "position_name": "Agente Administrativo",
      "exam_year": 2024,
      "difficulty": "medium",
      "source_reference": "agente_administrativo.pdf, questão 44; agente_administrativo_gabarito.pdf",
      "options": [
